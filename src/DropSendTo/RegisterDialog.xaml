<Window x:Class="DropSendTo.RegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Slot" Height="400" Width="540" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Title" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" Margin="6,2" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Shift+Enter で改行 / ↵ ボタンで挿入"/>
        <Button Content="↵" Grid.Row="0" Grid.Column="2" Margin="6,2" Width="28" Click="OnInsertNewline"/>

        <TextBlock Text="Command" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="CommandBox" Grid.Row="1" Grid.Column="1" Margin="6,2"/>
        <Button Content="..." Grid.Row="1" Grid.Column="2" Margin="6,2" Width="28" Click="OnBrowse"/>

        <TextBlock Text="Args Template" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="ArgsBox" Grid.Row="2" Grid.Column="1" Margin="6,2" Grid.ColumnSpan="2" Text="{}{args}"/>

        <TextBlock Text="Macro Script" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
        <TextBox x:Name="MacroBox"
                 Grid.Row="3"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 Margin="6,2"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 MinHeight="70"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                   Margin="6,8,0,0"
                   Foreground="#CCCCCC"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Text="コマンド一覧:&#x0a;  KEY &lt;組み合わせ&gt;   例: KEY Ctrl+Shift+S / KEY Alt+F4&#x0a;  KEYDOWN &lt;キー&gt;    押しっぱなしにする（例: KEYDOWN Ctrl）&#x0a;  KEYUP &lt;キー&gt;      離す（例: KEYUP Ctrl）&#x0a;  TEXT &lt;文字列&gt;     Unicode文字列をそのまま送信（例: TEXT こんにちは）&#x0a;  CLIPTEXT &lt;文字列&gt;  文字列をクリップボードへ設定して貼り付け&#x0a;  WAIT &lt;ミリ秒&gt;     指定時間待機（例: WAIT 250）&#x0a;  REPEAT &lt;回数&gt;     ENDREPEAT までを繰り返す（入れ子可）&#x0a;&#x0a;ヒント: 修飾キーは Ctrl, Shift, Alt, Win, LWin, RWin。複数行は上から順に実行。行頭が # の行と空行はスキップされます。"/>

        <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="4" IsDefault="True" Click="OnOk"/>
            <Button Content="Cancel" Width="80" Margin="4" IsCancel="True"/>
        </StackPanel>
    </Grid>
    
</Window>
