<Window x:Class="DropSendTo.RegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DropSendTo.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Edit Slot" Height="560" Width="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        Background="{DynamicResource Theme.WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Height="32" Background="{DynamicResource Theme.SurfaceBackgroundBrush}" MouseLeftButtonDown="OnTitleBarDrag">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
                <Button Content="✕"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="32"
                        Height="24"
                        Margin="0,4,6,4"
                        DockPanel.Dock="Right"
                        Padding="0"
                        Click="OnCloseClicked"/>
            </DockPanel>
        </Border>

        <Grid Margin="12" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Title" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" Margin="6,2" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Shift+Enter で改行 / ↵ ボタンで挿入"/>
        <Button Content="↵" Grid.Row="0" Grid.Column="2" Margin="6,2" Width="28" Click="OnInsertNewline"/>

        <TextBlock Text="Search Keywords" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="SearchKeywordBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="6,2"
                 Grid.ColumnSpan="2"
                 ToolTip="検索用キーワード（スペース区切り）。タイトルと併せて部分一致で検索されます"/>

        <TextBlock Text="Slot Color" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox x:Name="ColorComboBox"
                  Grid.Row="2"
                  Grid.Column="1"
                  Margin="6,2"
                  HorizontalAlignment="Stretch"
                  SelectedValuePath="Color">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36"
                                Height="18"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{Binding AccentBrush}"
                                Background="{Binding BackgroundBrush}">
                            <Grid>
                                <Rectangle Height="6"
                                           VerticalAlignment="Top"
                                           Fill="{Binding AccentBrush}"
                                           Opacity="0.9"/>
                                <TextBlock Text="Aa"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding ForegroundBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="登録モード" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox x:Name="ModeComboBox"
                  Grid.Row="3"
                  Grid.Column="1"
                  Margin="6,2"
                  HorizontalAlignment="Stretch"
                  SelectedValuePath="Tag"
                  ToolTip="Command / Macro Script / Macro Script 拡張モードを切り替えます">
            <ComboBoxItem Content="Command モード" Tag="{x:Static models:SlotExecutionMode.Command}"/>
            <ComboBoxItem Content="Macro Script モード" Tag="{x:Static models:SlotExecutionMode.MacroScript}"/>
            <ComboBoxItem Content="Macro Script 拡張モード" Tag="{x:Static models:SlotExecutionMode.MacroScriptExtended}"/>
        </ComboBox>

        <TextBlock Text="Command" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="CommandBox" Grid.Row="4" Grid.Column="1" Margin="6,2"/>
        <Button x:Name="CommandBrowseButton" Content="..." Grid.Row="4" Grid.Column="2" Margin="6,2" Width="28" Click="OnBrowse"/>

        <TextBlock Text="Args Template" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="ArgsBox" Grid.Row="5" Grid.Column="1" Margin="6,2" Grid.ColumnSpan="2" Text="{}{args}" ToolTip="テンプレート内の {args} が選択したパス列に置き換わります。&#x0a;{clipboard} はクリップボード文字列を展開します。&#x0a;{clipboard_args} はクリップボード内のパスを引用付きで展開します。&#x0a;{clipboard_args:n} は直近 n 行（1〜20）を古い順に展開します。&#x0a;例: /select {args}"/>

        <TextBlock Text="Shortcut" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="ShortcutBox" Grid.Row="6" Grid.Column="1" Margin="6,2" Grid.ColumnSpan="2" ToolTip="例: Ctrl+Shift+1 / F5 / Alt+S / B A&#x0a;複数キーはスペース/カンマ/&gt; で区切って入力できます&#x0a;prefix+Shortcut ボタンでショートカットを実行できます"/>

        <TextBlock Text="実行後に最小化" Grid.Row="7" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0"/>
        <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="6,2" Orientation="Vertical">
            <TextBlock Text="トリガー" Margin="0,0,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" FontSize="11"/>
            <UniformGrid Columns="4">
                <CheckBox x:Name="MinimizeOnClickCheckBox" Content="クリック時" Margin="0,0,12,0"/>
                <CheckBox x:Name="MinimizeOnShortcutCheckBox" Content="ショートカット時" Margin="0,0,12,0"/>
                <CheckBox x:Name="MinimizeOnDropCheckBox" Content="ドロップ時" Margin="0,0,0,0"/>
                <CheckBox x:Name="MinimizeOnKeyboardCheckBox" Content="キーボード操作時" Margin="0,0,0,0"/>
            </UniformGrid>
        </StackPanel>

        <TextBlock Text="Macro Script" Grid.Row="8" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
        <TextBox x:Name="MacroBox"
                 Grid.Row="8"
                 Grid.Column="1"
                 Margin="6,2"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 MinHeight="110"
                 MinLines="5"
                 MaxLines="50"/>
        <StackPanel Grid.Row="8" Grid.Column="2" Margin="6,6,6,0" VerticalAlignment="Top">
            <Button Content="?" Width="32" Height="26" Click="OnShowMacroTips" ToolTip="マクロスクリプトの書き方ヒントを表示"/>
            <Separator Margin="0,6,0,6"/>
            <Button x:Name="RecordStartButton"
                    Content="記録開始"
                    Margin="0,0,0,4"
                    Width="90"
                    Click="OnRecordStart"
                    ToolTip="Macro Script へ入力を記録します"/>
            <Button x:Name="RecordStopButton"
                    Content="記録停止"
                    Width="90"
                    Click="OnRecordStop"
                    IsEnabled="False"
                    ToolTip="記録を終了し、取得した操作を Macro Script に追加します"/>
            <Separator Margin="0,6,0,6"/>
            <Button x:Name="MacroInsertButton"
                    Content="挿入..."
                    Width="90"
                    Click="OnMacroInsertClick"
                    ToolTip="Macro Script Tips のグループごとにコマンドや予約語を選んで挿入します"/>
        </StackPanel>

        <TextBlock x:Name="RecordingStatusText"
                   Grid.Row="9"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Margin="6,2,6,0"
                   Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Text=""/>

        <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                   Margin="6,8,0,0"
                   Foreground="{DynamicResource Theme.MutedTextBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Text="ヒント: マクロの詳細は「?」から開く Tips で確認できます。行頭が # の行と空行はスキップされます。"/>

        <StackPanel Orientation="Horizontal" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="90" Height="32" Margin="4" IsDefault="True" Click="OnOk"/>
            <Button Content="Cancel" Width="90" Height="32" Margin="4" Click="OnCancel"/>
        </StackPanel>
        </Grid>
    </Grid>
    
</Window>
