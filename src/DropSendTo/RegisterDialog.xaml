<Window x:Class="DropSendTo.RegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Slot" Height="520" Width="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Title" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" Margin="6,2" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Shift+Enter で改行 / ↵ ボタンで挿入"/>
        <Button Content="↵" Grid.Row="0" Grid.Column="2" Margin="6,2" Width="28" Click="OnInsertNewline"/>

        <TextBlock Text="登録モード" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="6,2">
            <ToggleButton x:Name="MacroModeToggle"
                          Width="160"
                          HorizontalAlignment="Left"
                          Checked="OnModeToggleChanged"
                          Unchecked="OnModeToggleChanged">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Content" Value="Command モード"/>
                        <Setter Property="ToolTip" Value="Command と Macro Script のいずれか一方のみ登録できます"/>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="Macro Script モード"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </StackPanel>

        <TextBlock Text="Command" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="CommandBox" Grid.Row="2" Grid.Column="1" Margin="6,2"/>
        <Button x:Name="CommandBrowseButton" Content="..." Grid.Row="2" Grid.Column="2" Margin="6,2" Width="28" Click="OnBrowse"/>

        <TextBlock Text="Args Template" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="ArgsBox" Grid.Row="3" Grid.Column="1" Margin="6,2" Grid.ColumnSpan="2" Text="{}{args}" ToolTip="テンプレート内の {args} が選択したパス列に置き換わります。&#x0a;{clipboard} はクリップボード文字列を展開します。&#x0a;{clipboard_args} はクリップボード内のパスを引用付きで展開します。&#x0a;例: /select {args}"/>

        <TextBlock Text="Shortcut" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="ShortcutBox" Grid.Row="4" Grid.Column="1" Margin="6,2" Grid.ColumnSpan="2" ToolTip="例: Ctrl+Shift+1 / F5 / Alt+S&#x0a;prefix+Shortcut ボタンでショートカットを実行できます"/>

        <TextBlock Text="Macro Script" Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
        <TextBox x:Name="MacroBox"
                 Grid.Row="5"
                 Grid.Column="1"
                 Margin="6,2"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 MinHeight="110"
                 MinLines="5"
                 MaxLines="50"/>
        <StackPanel Grid.Row="5" Grid.Column="2" Margin="6,6,6,0" VerticalAlignment="Top">
            <Button Content="?" Width="32" Height="26" Click="OnShowMacroTips" ToolTip="マクロスクリプトの書き方ヒントを表示"/>
            <Separator Margin="0,6,0,6"/>
            <Button x:Name="RecordStartButton"
                    Content="記録開始"
                    Margin="0,0,0,4"
                    Width="90"
                    Click="OnRecordStart"
                    ToolTip="Macro Script へ入力を記録します"/>
            <Button x:Name="RecordStopButton"
                    Content="記録停止"
                    Width="90"
                    Click="OnRecordStop"
                    IsEnabled="False"
                    ToolTip="記録を終了し、取得した操作を Macro Script に追加します"/>
        </StackPanel>

        <TextBlock x:Name="RecordingStatusText"
                   Grid.Row="6"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Margin="6,2,6,0"
                   Foreground="#DDDDDD"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Text=""/>

        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                   Margin="6,8,0,0"
                   Foreground="#CCCCCC"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Text="ヒント: マクロの詳細は「?」から開く Tips で確認できます。行頭が # の行と空行はスキップされます。"/>

        <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="90" Height="32" Margin="4" IsDefault="True" Click="OnOk"/>
            <Button Content="Cancel" Width="90" Height="32" Margin="4" Click="OnCancel"/>
        </StackPanel>
    </Grid>
    
</Window>
