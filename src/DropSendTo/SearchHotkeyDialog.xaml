<Window x:Class="DropSendTo.SearchHotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Search Hotkey" Height="280" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        Background="{DynamicResource Theme.WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Height="32" Background="{DynamicResource Theme.SurfaceBackgroundBrush}" MouseLeftButtonDown="OnTitleBarDrag">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
                <Button Content="✕"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="32"
                        Height="24"
                        Margin="0,4,6,4"
                        DockPanel.Dock="Right"
                        Padding="0"
                        Click="OnCloseClicked"/>
            </DockPanel>
        </Border>

        <Grid Margin="14" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <CheckBox x:Name="EnableCheckBox"
                  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="検索用ホットキーを有効にする"
                  Margin="0,0,0,8"
                  Checked="OnEnableChanged"
                  Unchecked="OnEnableChanged"/>

        <TextBlock Text="ホットキー"
                   Grid.Row="1" Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>
        <TextBox x:Name="HotkeyBox"
                 Grid.Row="1" Grid.Column="1"
                 Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="{DynamicResource Theme.MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="例: Alt+Space / Ctrl+Shift+F / Win+1（単一キーまたは修飾付き）。Prefix+Alt+Space でも検索レイヤーは呼び出せます。"/>

        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{DynamicResource Theme.AlertBackgroundBrush}" BorderBrush="{DynamicResource Theme.AlertBorderBrush}" BorderThickness="1.5" CornerRadius="6"
                Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⚠" Margin="0,0,6,0" Foreground="{DynamicResource Theme.PrimaryTextBrush}" FontWeight="Bold" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Theme.PrimaryTextBrush}"
                           Text="Alt+Space などは他のランチャーや OS のショートカットと競合しやすいので慎重に設定してください。"/>
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorBlock"
                   Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="{DynamicResource Theme.AlertTextBrush}" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    HorizontalAlignment="Right">
            <Button Content="OK" Width="90" Height="32" Margin="4" IsDefault="True" Click="OnOk"/>
            <Button Content="Cancel" Width="90" Height="32" Margin="4" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
