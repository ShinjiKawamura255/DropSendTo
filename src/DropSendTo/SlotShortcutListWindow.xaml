<Window x:Class="DropSendTo.SlotShortcutListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="ショートカット一覧"
        Height="420"
        Width="560"
        MinWidth="440"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Prefix 後に実行できるショートカット登録済みのスロット一覧です。列ヘッダーをクリックするとソートできます。"
                   TextWrapping="Wrap"
                   Margin="0 0 0 10"/>

        <Grid Grid.Row="1">
            <DataGrid x:Name="ShortcutGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      Margin="0 0 0 8">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasParseError}" Value="True">
                                <Setter Property="Background" Value="#33FF5555"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                <Setter Property="Background" Value="#33FFA500"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsShadowed}" Value="True">
                                <Setter Property="Background" Value="#333366FF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        MinWidth="90"
                                        Width="*"
                                        SortMemberPath="Status"/>
                    <DataGridTextColumn Header="Slot ID"
                                        Binding="{Binding SlotId}"
                                        MinWidth="120"
                                        Width="*"
                                        SortMemberPath="SlotSortKey"/>
                    <DataGridTextColumn Header="Title"
                                        Binding="{Binding Title}"
                                        MinWidth="180"
                                        Width="2*"
                                        SortMemberPath="Title"/>
                    <DataGridTextColumn Header="Shortcut"
                                        Binding="{Binding ShortcutKey}"
                                        MinWidth="150"
                                        Width="*"
                                        SortMemberPath="ShortcutKey"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyState"
                       Text="ショートカットが登録されたスロットはありません。"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#888888"
                       Visibility="Collapsed"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="閉じる"
                    Width="100"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
