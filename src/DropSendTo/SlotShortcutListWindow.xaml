<Window x:Class="DropSendTo.SlotShortcutListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:ClassModifier="internal"
        Title="ショートカット一覧"
        Height="420"
        Width="560"
        MinWidth="440"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource Theme.WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Height="32" Background="{StaticResource Theme.SurfaceBackgroundBrush}" MouseLeftButtonDown="OnTitleBarDrag">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Theme.PrimaryTextBrush}"/>
                <Button Content="✕"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="32"
                        Height="24"
                        Margin="0,4,6,4"
                        DockPanel.Dock="Right"
                        Padding="0"
                        Click="OnClose"/>
            </DockPanel>
        </Border>

        <Grid Margin="12" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Prefix 後に実行できるショートカット登録済みのスロット一覧です。列ヘッダーをクリックするとソートできます。"
                   TextWrapping="Wrap"
                   Margin="0 0 0 10"/>

        <Grid Grid.Row="1">
            <DataGrid x:Name="ShortcutGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      Margin="0 0 0 8"
                      Background="{StaticResource Theme.SurfaceBackgroundBrush}"
                      Foreground="{StaticResource Theme.PrimaryTextBrush}"
                      BorderBrush="{StaticResource Theme.BorderBrush}">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource Theme.DataGridHeaderBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource Theme.PrimaryTextBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Theme.BorderBrush}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{StaticResource Theme.SurfaceBackgroundBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource Theme.DataGridRowSelectedBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding HasParseError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Theme.RowErrorBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Theme.RowWarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsShadowed}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Theme.RowShadowedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        MinWidth="90"
                                        Width="*"
                                        SortMemberPath="Status"/>
                    <DataGridTextColumn Header="Slot ID"
                                        Binding="{Binding SlotId}"
                                        MinWidth="120"
                                        Width="*"
                                        SortMemberPath="SlotSortKey"/>
                    <DataGridTextColumn Header="Title"
                                        Binding="{Binding Title}"
                                        MinWidth="180"
                                        Width="2*"
                                        SortMemberPath="Title"/>
                    <DataGridTextColumn Header="Shortcut"
                                        Binding="{Binding ShortcutKey}"
                                        MinWidth="150"
                                        Width="*"
                                        SortMemberPath="ShortcutKey"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyState"
                       Text="ショートカットが登録されたスロットはありません。"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Theme.PlaceholderTextBrush}"
                       Visibility="Collapsed"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="閉じる"
                    Width="100"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnClose"/>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
