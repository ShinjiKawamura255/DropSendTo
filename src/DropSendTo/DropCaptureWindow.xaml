<Window x:Class="DropSendTo.DropCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropCaptureWindow"
        Width="260"
        Height="120"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="True"
        ShowActivated="True"
        UseLayoutRounding="True"
        SizeToContent="WidthAndHeight"
        AllowDrop="True"
        PreviewKeyDown="OnPreviewKeyDown"
        DragEnter="OnDragEnter"
        DragOver="OnDragOver"
        Drop="OnDrop">
    <Border x:Name="DropFrame"
            Background="{DynamicResource Theme.OverlayBackgroundBrush}"
            BorderBrush="{DynamicResource Theme.BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            AllowDrop="True"
            SnapsToDevicePixels="True">
        <StackPanel Orientation="Vertical">
            <TextBlock x:Name="TitleText"
                       Text="ここにドロップ"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.PrimaryTextBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="SubtitleText"
                       Text="ファイル/フォルダをドロップ"
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Theme.MutedTextBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
