<Window x:Class="DropSendTo.SearchOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SearchOverlayWindow"
        Width="280"
        Height="86"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="True"
        ShowActivated="True"
        UseLayoutRounding="True"
        SizeToContent="WidthAndHeight">
    <Border Background="{StaticResource Theme.OverlayBackgroundBrush}"
            BorderBrush="{StaticResource Theme.BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,10"
            SnapsToDevicePixels="True">
        <StackPanel Orientation="Vertical" Margin="0">
            <TextBlock Text="Search"
                       Margin="0,0,0,6"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{StaticResource Theme.PrimaryTextBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBox x:Name="SearchBox"
                     Width="240"
                     MinWidth="180"
                     Padding="8,4"
                     Background="{StaticResource Theme.InputBackgroundBrush}"
                     Foreground="{StaticResource Theme.PrimaryTextBrush}"
             BorderBrush="{StaticResource Theme.SubtleBorderBrush}"
             BorderThickness="1"
             CaretBrush="{StaticResource Theme.PrimaryTextBrush}"
             TextChanged="OnSearchTextChanged"
             KeyDown="OnSearchBoxKeyDown"
             KeyUp="OnSearchBoxKeyUp"/>
        </StackPanel>
    </Border>
</Window>
