<Window x:Class="DropSendTo.CustomSlotSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Custom Slot Size"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Height="360"
        Width="420"
        WindowStartupLocation="CenterOwner">
    <Border Padding="12" Background="{DynamicResource Theme.WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock Text="Custom Slot Size"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
                <Button Content="✕"
                        Width="28"
                        Height="24"
                        DockPanel.Dock="Right"
                        Padding="0"
                        Margin="0,0,0,0"
                        Click="OnClose"/>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,12,0,12" VerticalAlignment="Top">
                <TextBlock x:Name="ErrorBlock"
                           Foreground="{DynamicResource Theme.AlertTextBrush}"
                           Visibility="Collapsed"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"/>

                <UniformGrid Columns="2" Rows="3" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="スロット高さ (px)" Margin="0,0,0,2"/>
                        <TextBox x:Name="SlotHeightBox" />
                        <TextBlock Text="24〜120。タイトル/ステータスのフォントと余白を含む高さの基準になります。" FontSize="11" Foreground="{DynamicResource Theme.SubtleTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,8">
                        <TextBlock Text="タイトルフォントサイズ" Margin="0,0,0,2"/>
                        <TextBox x:Name="TitleFontBox" />
                        <TextBlock Text="8〜18。大きくすると高さの最低値も上がります。" FontSize="11" Foreground="{DynamicResource Theme.SubtleTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="ステータスフォントサイズ" Margin="0,0,0,2"/>
                        <TextBox x:Name="StatusFontBox" />
                        <TextBlock Text="8〜16。Status 行の高さに影響します。" FontSize="11" Foreground="{DynamicResource Theme.SubtleTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,8">
                        <TextBlock Text="スロット間隔 (px)" Margin="0,0,0,2"/>
                        <TextBox x:Name="SlotMarginBox" />
                        <TextBlock Text="0〜12。スロット外側の余白（上下左右）。ドラッグ間隔や行列の総サイズにも反映されます。" FontSize="11" Foreground="{DynamicResource Theme.SubtleTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="縦方向ステップ (px)" Margin="0,0,0,2"/>
                        <TextBox x:Name="RowStepBox" />
                        <TextBlock Text="行ピッチ。1 行目以降を並べる縦の間隔になります。Slot 高さ+余白より小さい値は自動で底上げされます。" FontSize="11" Foreground="{DynamicResource Theme.SubtleTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="横方向ステップ (px)" Margin="0,0,0,2"/>
                        <TextBox x:Name="ColumnStepBox" />
                        <TextBlock Text="列ピッチ。各列の横幅の基準になります。Small 幅を基準に 50〜120 を目安にし、それより狭い値は自動で補正されます。" FontSize="11" Foreground="{DynamicResource Theme.SubtleTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Apply"
                        Width="90"
                        Height="32"
                        Margin="6,0"
                        Click="OnApply"/>
                <Button Content="OK"
                        Width="90"
                        Height="32"
                        Margin="6,0"
                        IsDefault="True"
                        Click="OnOk"/>
                <Button Content="Cancel"
                        Width="90"
                        Height="32"
                        Margin="6,0"
                        IsCancel="True"
                        Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
