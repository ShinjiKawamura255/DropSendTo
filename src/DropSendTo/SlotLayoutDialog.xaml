<Window x:Class="DropSendTo.SlotLayoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Slot Layout"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource Theme.WindowBackgroundBrush}"
        Height="210"
        Width="340"
        WindowStartupLocation="CenterOwner">
    <Border Padding="12" Background="{StaticResource Theme.WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock Text="Slot Layout"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Theme.PrimaryTextBrush}"/>
                <Button Content="✕"
                        Width="28"
                        Height="24"
                        DockPanel.Dock="Right"
                        Padding="0"
                        Margin="0,0,0,0"
                        Click="OnClose"/>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,12,0,12">
                <TextBlock x:Name="ErrorBlock"
                           Foreground="{StaticResource Theme.AlertTextBrush}"
                           Visibility="Collapsed"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <UniformGrid Columns="2" Rows="1" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="行 (2〜8)" Margin="0,0,0,2"/>
                        <TextBox x:Name="RowsBox"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="列 (2〜8)" Margin="0,0,0,2"/>
                        <TextBox x:Name="ColumnsBox"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="2〜8 の範囲で行と列を指定してください。変更後は即時反映され、全レイヤーのスロット容量が拡張されます。"
                           FontSize="11"
                           Foreground="{StaticResource Theme.SubtleTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="OK"
                        Width="90"
                        Height="32"
                        Margin="6,0"
                        IsDefault="True"
                        Click="OnOk"/>
                <Button Content="Cancel"
                        Width="90"
                        Height="32"
                        Margin="6,0"
                        IsCancel="True"
                        Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
