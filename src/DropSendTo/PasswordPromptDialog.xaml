<Window x:Class="DropSendTo.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:ClassModifier="internal"
        Title="Password"
        MinHeight="240"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Height="32"
                Background="{DynamicResource Theme.SurfaceBackgroundBrush}"
                MouseLeftButtonDown="OnTitleBarDrag">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
                <Button Content="✕"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="32"
                        Height="24"
                        Margin="0,4,6,4"
                        DockPanel.Dock="Right"
                        Padding="0"
                        Click="OnCloseClicked"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   Margin="0 0 0 12"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="パスワード"
                       Margin="0 0 0 4"/>
            <PasswordBox x:Name="PasswordBox"
                         PasswordChanged="OnPasswordChanged"
                         MinWidth="220"/>
        </StackPanel>

        <StackPanel x:Name="ConfirmPanel"
                    Grid.Row="2"
                    Margin="0 12 0 0">
            <TextBlock Text="パスワード (確認)"
                       Margin="0 0 0 4"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         PasswordChanged="OnPasswordChanged"
                         MinWidth="220"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="3"
                   Margin="0 12 0 0"
                   Foreground="{DynamicResource Theme.ValidationTextBrush}"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 16 0 0">
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="90"
                    Margin="0 0 8 0"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="OnOk"/>
            <Button Content="キャンセル"
                    Width="90"
                    IsCancel="True"
                    Click="OnCancel"/>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
