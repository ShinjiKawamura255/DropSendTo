<Window x:Class="DropSendTo.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="DropSendTo について" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.PrimaryTextBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="DropSendTo" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="CurrentVersionText" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="LatestVersionText" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="DownloadHintText" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <WrapPanel Margin="0,20,0,0">
            <Button x:Name="DownloadButton" Margin="0,0,8,8" Padding="12,6" Click="OnDownload" Visibility="Collapsed"/>
            <Button x:Name="RetryButton" Margin="0,0,8,8" Padding="12,6" Click="OnRetry"/>
            <Button x:Name="ReleasesButton" Margin="0,0,8,8" Padding="12,6" Click="OnReleases"/>
        </WrapPanel>
        <Button x:Name="CloseButton" HorizontalAlignment="Right" MinWidth="80" Padding="12,6" IsCancel="True" Click="OnClose"/>
    </StackPanel>
</Window>
