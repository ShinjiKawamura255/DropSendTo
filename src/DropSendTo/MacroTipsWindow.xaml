<Window x:Class="DropSendTo.MacroTipsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Macro Script Tips"
        Height="520"
        Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="560"
        MinHeight="420"
        WindowStyle="None"
        Background="{StaticResource Theme.WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TipsMonoTextStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Theme.CodeTextBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Height="32" Background="{StaticResource Theme.SurfaceBackgroundBrush}" MouseLeftButtonDown="OnTitleBarDrag">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Theme.PrimaryTextBrush}"/>
                <Button Content="✕"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="32"
                        Height="24"
                        Margin="0,4,6,4"
                        DockPanel.Dock="Right"
                        Padding="0"
                        Click="OnCloseClicked"/>
            </DockPanel>
        </Border>

        <Grid Margin="12" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="Macro Script Tips" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                <TextBlock Text="基本ルール" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="・各行を上から順番に実行します　・先頭/末尾の空白は無視されます　・空行と「#」で始まる行はコメントとしてスキップされます" TextWrapping="NoWrap" Margin="0,0,0,12"/>

                <TextBlock Text="変数" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="{StaticResource Theme.CardBackgroundBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="SET &lt;名前&gt; &lt;値&gt;           : 変数を定義 (例: SET UserName Alice)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="UNSET &lt;名前&gt;              : 変数を削除 (例: UNSET UserName)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="ADD/SUB/MUL/DIV &lt;名前&gt; &lt;整数&gt; : 変数を整数として四則演算 (例: ADD Counter 1)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="APPEND/PREPEND &lt;名前&gt; &lt;文字列&gt; : 前後に文字列を結合 (例: APPEND Message !)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="REPLACE &lt;名前&gt; &quot;検索&quot; &quot;置換&quot; : 文字列をまとめて置換（空文字列を指定すると削除）" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="REPLACE_REGEX &lt;名前&gt; &quot;正規表現&quot; &quot;置換&quot; [オプション] : 拡張正規表現で置換（$1 等を利用可 / IGNORECASE, MULTILINE, SINGLELINE, IGNOREWHITESPACE）" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="RENAME &lt;元パス&gt; &lt;新しいパス&gt; : ファイル/フォルダをリネーム（パスは変数展開とクォートに対応）" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="RESOLVE_LINK &lt;変数&gt; &lt;パス&gt; : .lnk / シンボリックリンクの実体パスを取得して変数に格納（リンクでなければ元パスを格納）" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="READFILE &lt;変数&gt; &lt;パス&gt; [MAX &lt;バイト&gt;] : ファイル内容を変数に読み込み（既定 4096 バイトまで / それ以上は MAX 指定が必要）" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="RETURN [&quot;メッセージ&quot;] : マクロを即終了（オプションのメッセージはログ/結果用）" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="プレースホルダー {{名前}}   : 任意のコマンドで値を展開 (例: TEXT Hello {{UserName}})" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="ドロップ引数 {{drop_args}} / {{drop_count}} : Macro Script 拡張でパスをドロップした時の引数/件数を参照 (例: COMMAND {{drop_args}})" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="ドロップパス {{drop_path}} / {{drop_path:n}} : 先頭または n 番目(1〜)のパスを取得 (例: SET First {{drop_path:1}})" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="TESTPATH &lt;名前&gt; &lt;パス&gt; : ファイル/フォルダの存在を確認して 1 (存在) / 0 (未存在) を変数へ格納 (例: TESTPATH PathOk {{drop_path}})" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="POPUP &quot;メッセージ&quot; : 任意のテキストをポップアップで表示 (例: POPUP &quot;{{drop_path}} が見つかりません&quot;)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="PROMPT &lt;名前&gt; &quot;メッセージ&quot; [DEFAULT &quot;初期値&quot;] : メッセージを表示し、入力結果を変数へ格納（キャンセル時はマクロ失敗）" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="変数名は英数字と「_」のみ。先頭は文字か「_」を指定してください。" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="フロー制御 / Prefix" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="{StaticResource Theme.CardBackgroundBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="WAIT &lt;ミリ秒&gt;         : 0〜60000 の待機 (例: WAIT 250)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="REPEAT &lt;回数&gt;         : ブロック開始 (例: REPEAT 5) - 単独で 1 行に記述" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="ENDREPEAT              : ブロック終了 - 対応する REPEAT とペアで別行に記述" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="FOREACH_DROP &lt;変数&gt; [INDEX &lt;番号変数&gt;] : ドロップした各パスでブロックを繰り返し、{{変数}} で現在のパス、INDEX で 1 基点の番号を参照" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="ENDFOREACH             : FOREACH_DROP の終了。ドロップ 0 件ならブロックはスキップ" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="COMMAND [引数]         : Macro Script 拡張モード専用。引数省略でテンプレートを展開、指定時は変数展開後の文字列をそのまま渡す" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="PREFIX [SEND|ARM]      : DropSendTo の Prefix を入力（ショートカット待機状態に移行）" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="PREFIX PASSTHROUGH     : Prefix を前面アプリへそのまま送出" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="IF / ELSEIF / ELSE / ENDIF : 条件分岐。演算子は ==, !=, &gt;, &gt;=, &lt;, &lt;=, CONTAINS, NOTCONTAINS, STARTSWITH, ENDSWITH をサポート" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="空白を含む値は &quot;&quot; で囲んでください（例: IF &quot;Hello World&quot; CONTAINS &quot;World&quot;）" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="キーボード操作" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="{StaticResource Theme.CardBackgroundBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="KEY &lt;修飾+キー&gt;      : 例) KEY Ctrl+Shift+S / KEY Alt+F4" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="KEYDOWN &lt;キー&gt;        : 押しっぱなし (例: KEYDOWN Ctrl)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="KEYUP &lt;キー&gt;          : 離す (例: KEYUP Ctrl)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="TEXT &lt;文字列&gt;         : Unicode 文字列を送信" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="SETCLIP &lt;文字列&gt;       : 文字列をクリップボードに設定（貼り付けは自動で実行しない）" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="CLIPTEXT &lt;文字列&gt;      : 文字列をクリップボードに設定→自動で Ctrl+V" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="COMMAND 命令" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="{StaticResource Theme.CardBackgroundBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}"
                                 Text="COMMAND は Macro Script 拡張モード専用です。スロットに登録した Command/Args Template をマクロ内から呼び出します。"
                                 TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}"
                                 Text="書式: COMMAND [展開後の引数]   → 引数を省略すると Args Template をそのまま展開して実行します。"
                                 TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}"
                                 Text="例: COMMAND {{clipboard}}       → クリップボード文字列を引数としてコマンドを実行。"
                                 TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}"
                                 Text="例: COMMAND                     → Args Template（{args} など）を展開して実行。"
                                 TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="マウス操作" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="{StaticResource Theme.CardBackgroundBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSEMOVEABS &lt;X&gt; &lt;Y&gt; : 仮想スクリーン座標へ絶対移動 (ピクセル)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSEMOVEWIN &lt;dX&gt; &lt;dY&gt; : アクティブウィンドウ左上からの相対座標へ移動" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSEMOVEREL &lt;dX&gt; &lt;dY&gt; : 現在位置から相対移動" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSELEFTDOWN / MOUSELEFTUP    : 左ボタン押下 / 解放" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSERIGHTDOWN / MOUSERIGHTUP  : 右ボタン押下 / 解放" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSEMIDDLEDOWN / MOUSEMIDDLEUP: 中ボタン押下 / 解放" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSELEFTCLICK / MOUSERIGHTCLICK / MOUSEMIDDLECLICK : 各ボタンのクリック" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSELEFTDOUBLECLICK           : 左ボタンのダブルクリック" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSESCROLLUP/DOWN [回数]      : 垂直スクロール (回数省略時はホイールを 1 ノッチ回した量)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSESCROLLLEFT/RIGHT [回数]   : 水平スクロール (回数省略時はホイールを 1 ノッチ回した量)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="座標予約語: WIN_TOPLEFT / WIN_TOPCENTER / WIN_TOPRIGHT / WIN_LEFTCENTER / WIN_RIGHTCENTER / WIN_BOTTOMLEFT / WIN_BOTTOMCENTER / WIN_BOTTOMRIGHT / WIN_CENTER" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="            互換表記: WIN_TOPMIDDLE / WIN_LEFTMIDDLE / WIN_RIGHTMIDDLE / WIN_BOTTOMMIDDLE / WIN_MIDDLE / WIN_MID" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="            *_X / *_Y で各成分を数値として取得、SET / ADD などへ利用可能 (例: WIN_TOPLEFT_X)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="            CURSOR_START (_X / _Y) = マクロ開始時のカーソル位置 (実行中は不変)" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="よくある例" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="{StaticResource Theme.CardBackgroundBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="# コピーして貼り付け後にテキスト追記" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="KEY Ctrl+C" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="WAIT 200" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="TEXT processed" TextWrapping="NoWrap" Margin="0,0,0,8"/>

                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="# 指定位置に移動してダブルクリック→スクロール (アクティブウィンドウ中央)" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSEMOVEABS WIN_CENTER" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSELEFTDOUBLECLICK" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSESCROLLDOWN 3" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="# マクロ開始位置へ戻してクリックする例" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSEMOVEABS CURSOR_START" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSELEFTCLICK" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="# 座標を変数に取り込んでオフセットする例" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="SET BaseX WIN_TOPLEFT_X" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="SET BaseY WIN_TOPLEFT_Y" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="ADD BaseX 120" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="ADD BaseY 60" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="MOUSEMOVEABS {{BaseX}} {{BaseY}}" TextWrapping="NoWrap" Margin="0,0,0,8"/>

                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="# クリップボードから空白を削除する例" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="SET Body {{clipboard}}" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="REPLACE Body &quot; &quot; &quot;&quot;" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="TEXT {{Body}}" TextWrapping="NoWrap" Margin="0,0,0,8"/>

                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="# REPEAT ブロックの例" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="REPEAT 3" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="    KEYDOWN Shift" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="    KEY A" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="    KEYUP Shift" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="ENDREPEAT" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="# FOREACH_DROP でドロップした各パスを処理する例" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="FOREACH_DROP Item INDEX i" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="    SET Body {{Item}}" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="    REPLACE Body &quot; &quot; &quot;_&quot;" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="    TEXT [{{i}}] {{Body}}" TextWrapping="NoWrap"/>
                        <TextBox Style="{StaticResource TipsMonoTextStyle}" Text="ENDFOREACH" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="補足" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="・修飾キーは Ctrl / Shift / Alt / Win / LWin / RWin を指定できます　・CLIPTEXT 実行後は自動的に少し待機してから Ctrl+V を送ります　・マクロ実行中にキャンセルすると実行中のキー/ボタンは自動で解放されます　・SET/UNSET で定義した変数はどのコマンドでも {{変数名}} と書くと展開されます　・ADD/SUB/MUL/DIV は 64bit 整数で計算し、DIV では 0 除算を禁止しています" TextWrapping="NoWrap" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="閉じる" Width="100" Height="32" IsCancel="True" IsDefault="True" Click="OnCloseClicked"/>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
