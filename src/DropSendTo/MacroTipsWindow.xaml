<Window x:Class="DropSendTo.MacroTipsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macro Script Tips"
        Height="520"
        Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="560"
        MinHeight="420"
        WindowStyle="ToolWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="Macro Script Tips" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                <TextBlock Text="基本ルール" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="・各行を上から順番に実行します　・先頭/末尾の空白は無視されます　・空行と「#」で始まる行はコメントとしてスキップされます" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="変数" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="#1E1E1E" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="SET &lt;名前&gt; &lt;値&gt;           : 変数を定義 (例: SET UserName Alice)" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="UNSET &lt;名前&gt;              : 変数を削除 (例: UNSET UserName)" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="ADD/SUB/MUL/DIV &lt;名前&gt; &lt;整数&gt; : 変数を整数として四則演算 (例: ADD Counter 1)" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="APPEND/PREPEND &lt;名前&gt; &lt;文字列&gt; : 前後に文字列を結合 (例: APPEND Message !)" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="プレースホルダー {{名前}}   : 任意のコマンドで値を展開 (例: TEXT Hello {{UserName}})" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="変数名は英数字と「_」のみ。先頭は文字か「_」を指定してください。" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="キーボード操作" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="#1E1E1E" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="KEY &lt;修飾+キー&gt;      : 例) KEY Ctrl+Shift+S / KEY Alt+F4" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="KEYDOWN &lt;キー&gt;        : 押しっぱなし (例: KEYDOWN Ctrl)" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="KEYUP &lt;キー&gt;          : 離す (例: KEYUP Ctrl)" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="TEXT &lt;文字列&gt;         : Unicode 文字列を送信" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="CLIPTEXT &lt;文字列&gt;      : 文字列をクリップボードに設定→自動で Ctrl+V" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="WAIT &lt;ミリ秒&gt;         : 0〜60000 の待機 (例: WAIT 250)" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="REPEAT &lt;回数&gt;         : ブロック開始 (例: REPEAT 5) - 単独で 1 行に記述" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="ENDREPEAT              : ブロック終了 - 対応する REPEAT とペアで別行に記述" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="マウス操作" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="#1E1E1E" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="MOUSEMOVEABS &lt;X&gt; &lt;Y&gt; : 仮想スクリーン座標へ絶対移動 (ピクセル)" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="MOUSEMOVEREL &lt;dX&gt; &lt;dY&gt; : 現在位置から相対移動" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="MOUSELEFTDOWN / MOUSELEFTUP    : 左ボタン押下 / 解放" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="MOUSERIGHTDOWN / MOUSERIGHTUP  : 右ボタン押下 / 解放" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="MOUSEMIDDLEDOWN / MOUSEMIDDLEUP: 中ボタン押下 / 解放" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="MOUSELEFTCLICK / MOUSERIGHTCLICK / MOUSEMIDDLECLICK : 各ボタンのクリック" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="MOUSELEFTDOUBLECLICK           : 左ボタンのダブルクリック" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="MOUSESCROLLUP/DOWN [回数]      : 垂直スクロール (回数省略時はホイールを 1 ノッチ回した量)" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="MOUSESCROLLLEFT/RIGHT [回数]   : 水平スクロール (回数省略時はホイールを 1 ノッチ回した量)" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="よくある例" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="#1E1E1E" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="# コピーして貼り付け後にテキスト追記" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="KEY Ctrl+C" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="WAIT 200" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="TEXT processed" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="# 指定位置に移動してダブルクリック→スクロール" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="MOUSEMOVEABS 1200 640" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="MOUSELEFTDOUBLECLICK" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="MOUSESCROLLDOWN 3" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="" Margin="0,0,0,8"/>

                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="# REPEAT ブロックの例" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="REPEAT 3" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="    KEYDOWN Shift" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="    KEY A" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="    KEYUP Shift" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Consolas" Foreground="#F0F0F0" Text="ENDREPEAT" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="補足" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="・修飾キーは Ctrl / Shift / Alt / Win / LWin / RWin を指定できます　・CLIPTEXT 実行後は自動的に少し待機してから Ctrl+V を送ります　・マクロ実行中にキャンセルすると実行中のキー/ボタンは自動で解放されます　・SET/UNSET で定義した変数はどのコマンドでも {{変数名}} と書くと展開されます　・ADD/SUB/MUL/DIV は 64bit 整数で計算し、DIV では 0 除算を禁止しています" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="閉じる" Width="100" Height="32" IsCancel="True" IsDefault="True" Click="OnCloseClicked"/>
        </StackPanel>
    </Grid>
</Window>
