<Window x:Class="DropSendTo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropSendTo"
        Icon="img/icon.ico" Height="148" Width="234"
        AllowDrop="True"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource Theme.PrimaryTextBrush}"
        WindowStyle="None"
        ResizeMode="NoResize"
        PreviewMouseWheel="OnMouseWheel"
        ShowInTaskbar="False">
    <Window.ContextMenu>
        <ContextMenu Opened="OnContextMenuOpened">
            <MenuItem Header="設定ファイル / ログ">
                <MenuItem Header="Open Config" Click="OnOpenConfig"/>
                <MenuItem Header="Open Logs" Click="OnOpenLogs"/>
                <MenuItem Header="Export Config..." Click="OnExportConfig"/>
                <MenuItem Header="Import Config..." Click="OnImportConfig"/>
            </MenuItem>
            <MenuItem Header="Change Prefix..." Click="OnChangePrefix"/>
            <MenuItem Header="検索ホットキー..." Click="OnConfigureSearchHotkey"/>
            <MenuItem Header="レイヤー設定">
                <MenuItem Header="レイヤー数..." Click="OnConfigureLayerCount"/>
                <MenuItem Header="レイヤー名を編集..." Click="OnEditLayerNames"/>
            </MenuItem>
            <MenuItem Header="レイアウト / 表示">
                <MenuItem x:Name="LayoutMenuItem"
                          Header="Slot Layout..."
                          Click="OnConfigureSlotLayout"/>
                <MenuItem x:Name="SlotSizeMenuItem"
                          Header="Slot Size"
                          SubmenuOpened="OnSlotSizeMenuOpened"/>
                <MenuItem x:Name="HideEmptySlotNamesMenuItem"
                          Header="未登録スロット名を非表示"
                          IsCheckable="True"
                          Click="OnToggleHideEmptySlotNames"/>
            </MenuItem>
            <MenuItem Header="起動時のウィンドウ">
                <MenuItem x:Name="StartupAlwaysShowMenuItem"
                          Header="常にウィンドウを表示"
                          IsCheckable="True"
                          Click="OnStartupAlwaysShow"/>
                <MenuItem x:Name="StartupRestoreMenuItem"
                          Header="前回の状態を復元"
                          IsCheckable="True"
                          Click="OnStartupRestoreState"/>
            </MenuItem>
            <MenuItem Header="Macro 実行モード">
                <MenuItem x:Name="MacroModeExclusiveMenuItem"
                          Header="排他（単一実行のみ）"
                          IsCheckable="True"
                          Click="OnMacroModeExclusive"/>
                <MenuItem x:Name="MacroModeInterruptMenuItem"
                          Header="割り込み実行（実行中マクロを停止）"
                          IsCheckable="True"
                          Click="OnMacroModeInterrupt"/>
                <MenuItem x:Name="MacroModeSuspendMenuItem"
                          Header="一時停止して割り込み（完了後に元マクロ再開）"
                          IsCheckable="True"
                          Click="OnMacroModeSuspend"/>
            </MenuItem>
            <MenuItem Header="キーボード操作">
                <MenuItem x:Name="EmacsNavigationMenuItem"
                          Header="Emacs ライク操作"
                          IsCheckable="True"
                          Click="OnToggleEmacsNavigation"/>
                <MenuItem x:Name="ViNavigationMenuItem"
                          Header="vi ライク操作"
                          IsCheckable="True"
                          Click="OnToggleViNavigation"/>
            </MenuItem>
            <MenuItem Header="マウスジェスチャ (表示/最小化)..."
                      Click="OnConfigureMouseGestures"/>
            <MenuItem Header="表示挙動">
                <MenuItem Header="表示時のレイヤー切替..."
                          Click="OnConfigureShowLayerPreferences"/>
                <MenuItem Header="表示位置 (検索)">
                    <MenuItem x:Name="SearchPlacementFixedMenuItem"
                              Header="固定位置"
                              IsCheckable="True"
                              Click="OnSearchPlacementFixed"/>
                    <MenuItem x:Name="SearchPlacementFollowMouseMenuItem"
                              Header="マウスフォロー"
                              IsCheckable="True"
                              Click="OnSearchPlacementFollowMouse"/>
                    <MenuItem x:Name="SearchPlacementScreenCenterMenuItem"
                              Header="画面中央 (マウスがある画面)"
                              IsCheckable="True"
                              Click="OnSearchPlacementScreenCenter"/>
                </MenuItem>
                <MenuItem Header="表示位置 (キーボード)">
                    <MenuItem x:Name="KeyboardPlacementFixedMenuItem"
                              Header="固定位置"
                              IsCheckable="True"
                              Click="OnKeyboardPlacementFixed"/>
                    <MenuItem x:Name="KeyboardPlacementFollowMouseMenuItem"
                              Header="マウスフォロー"
                              IsCheckable="True"
                              Click="OnKeyboardPlacementMouseFollow"/>
                </MenuItem>
                <MenuItem Header="表示位置 (マウスジェスチャ)">
                    <MenuItem x:Name="MousePlacementFollowKeyboardMenuItem"
                              Header="キーボード設定に追従"
                              IsCheckable="True"
                              Click="OnMousePlacementFollowKeyboard"/>
                    <Separator/>
                    <MenuItem x:Name="MousePlacementFixedMenuItem"
                              Header="固定位置"
                              IsCheckable="True"
                              Click="OnMousePlacementFixed"/>
                    <MenuItem x:Name="MousePlacementFollowMouseMenuItem"
                              Header="マウスフォロー"
                              IsCheckable="True"
                              Click="OnMousePlacementMouseFollow"/>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="PrefixLayerShortcutMenuItem"
                      Header="Prefix: Ctrl+N/P でレイヤー切替"
                      IsCheckable="True"
                      Click="OnTogglePrefixLayerShortcuts"/>
            <MenuItem x:Name="RemoteSessionPriorityMenuItem"
                      Header="Prefix: リモートセッション優先 (RDP/Citrix)"
                      IsCheckable="True"
                      Click="OnToggleRemoteSessionPriority"/>
            <MenuItem Header="最小化トリガー..."
                      Click="OnConfigureMinimizeTriggers"/>
            <MenuItem Header="ショートカット一覧..."
                      Click="OnShowShortcutList"/>
            <Separator/>
            <MenuItem x:Name="AlwaysOnTopMenuItem"
                      Header="常に最前面に表示"
                      IsCheckable="True"
                      Click="OnToggleAlwaysOnTop"/>
            <Separator/>
            <MenuItem x:Name="MinimizeToTrayMenuItem"
                      Header="Minimize to Tray"
                      Click="OnMinimizeToTray"/>
            <MenuItem Header="Exit" Click="OnExit"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Border CornerRadius="12" Background="{StaticResource Theme.OverlayScrimBrush}" Padding="6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="PrefixIndicator"
                Grid.RowSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0"
                Padding="8,2"
                CornerRadius="8"
                Background="{StaticResource Theme.BadgeBackgroundBrush}"
                BorderBrush="{StaticResource Theme.BadgeBorderBrush}"
                BorderThickness="1"
                Visibility="Collapsed"
                Panel.ZIndex="10"
                IsHitTestVisible="False">
            <TextBlock x:Name="PrefixIndicatorText"
                       Text="PREFIX"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Theme.PrimaryTextBrush}"/>
        </Border>
        <Border x:Name="EditModeIndicator"
                Grid.Row="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,4,0,0"
                Padding="8,2"
                CornerRadius="8"
                Background="{StaticResource Theme.EditBadgeBackgroundBrush}"
                BorderBrush="{StaticResource Theme.EditBadgeBorderBrush}"
                BorderThickness="1"
                Visibility="Collapsed"
                Panel.ZIndex="11"
                IsHitTestVisible="False">
            <TextBlock x:Name="EditModeIndicatorText"
                       Text="SLOT SETUP MODE"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Theme.EditBadgeTextBrush}"/>
        </Border>
        <!-- Top bar with drag area and buttons (menu + layers equally spaced) -->
        <DockPanel Grid.Row="0" LastChildFill="False" Background="Transparent" MouseLeftButtonDown="OnDragMoveArea">
            <!-- Drag handle area to move window -->
            <Border DockPanel.Dock="Left" Background="Transparent" Height="24" MinWidth="40" MouseLeftButtonDown="OnDragMove"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="EditModeToggleButton"
                        Content="✎"
                        Width="24"
                        Height="24"
                        Margin="2"
                        ToolTip="Slot Setup Mode"
                        Click="OnEditModeToggleButtonClick"/>
                <Button x:Name="MenuBtn" Content="≡" Width="24" Height="24" Margin="2" Click="OnOpenMenu"/>
                <Button x:Name="LayerBtn1" Content="1" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayerButtonClick" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
                <Button x:Name="LayerBtn2" Content="2" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayerButtonClick" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
                <Button x:Name="LayerBtn3" Content="3" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayerButtonClick" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
                <Button x:Name="LayerBtn4" Content="4" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayerButtonClick" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid x:Name="SlotsPanel"
                     Grid.Row="1"
                     Rows="2"
                     Columns="2"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"/>
    </Grid>
    </Border>
</Window>
