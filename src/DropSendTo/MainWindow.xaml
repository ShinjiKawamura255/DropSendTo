<Window x:Class="DropSendTo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropSendTo" Height="148" Width="234"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFFFFFFF"
        WindowStyle="None"
        ResizeMode="NoResize"
        PreviewMouseWheel="OnMouseWheel">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Open Config" Click="OnOpenConfig"/>
            <Separator/>
            <MenuItem Header="Exit" Click="OnExit"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Border CornerRadius="12" Background="#CC000000" Padding="6">
    <Grid>
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="#111111"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#202020"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#666666"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#505050"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Top bar with drag area and buttons (menu + layers equally spaced) -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <!-- Drag handle area to move window -->
            <Border DockPanel.Dock="Left" Background="Transparent" Height="24" MinWidth="60" MouseLeftButtonDown="OnDragMove"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="MenuBtn" Content="≡" Width="24" Height="24" Margin="2" Click="OnOpenMenu"/>
                <Button x:Name="LayerBtn1" Content="1" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayer1" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
                <Button x:Name="LayerBtn2" Content="2" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayer2" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
                <Button x:Name="LayerBtn3" Content="3" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayer3" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
                <Button x:Name="LayerBtn4" Content="4" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayer4" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Row="0" Grid.Column="0" Margin="2" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Background="#111" Height="48" AllowDrop="True" Drop="OnSlotDrop" MouseRightButtonUp="OnSlotContextMenu" MouseEnter="OnSlotMouseEnter" MouseLeave="OnSlotMouseLeave" DragEnter="OnSlotDragEnter" DragLeave="OnSlotDragLeave" MouseLeftButtonDown="OnSlotMouseDown" MouseLeftButtonUp="OnSlotClick">
                <TextBlock x:Name="Slot1Text" Text="Slot 1" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Margin="2" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Background="#111" Height="48" AllowDrop="True" Drop="OnSlotDrop" MouseRightButtonUp="OnSlotContextMenu" MouseEnter="OnSlotMouseEnter" MouseLeave="OnSlotMouseLeave" DragEnter="OnSlotDragEnter" DragLeave="OnSlotDragLeave" MouseLeftButtonDown="OnSlotMouseDown" MouseLeftButtonUp="OnSlotClick">
                <TextBlock x:Name="Slot2Text" Text="Slot 2" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Margin="2" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Background="#111" Height="48" AllowDrop="True" Drop="OnSlotDrop" MouseRightButtonUp="OnSlotContextMenu" MouseEnter="OnSlotMouseEnter" MouseLeave="OnSlotMouseLeave" DragEnter="OnSlotDragEnter" DragLeave="OnSlotDragLeave" MouseLeftButtonDown="OnSlotMouseDown" MouseLeftButtonUp="OnSlotClick">
                <TextBlock x:Name="Slot3Text" Text="Slot 3" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Margin="2" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Background="#111" Height="48" AllowDrop="True" Drop="OnSlotDrop" MouseRightButtonUp="OnSlotContextMenu" MouseEnter="OnSlotMouseEnter" MouseLeave="OnSlotMouseLeave" DragEnter="OnSlotDragEnter" DragLeave="OnSlotDragLeave" MouseLeftButtonDown="OnSlotMouseDown" MouseLeftButtonUp="OnSlotClick">
                <TextBlock x:Name="Slot4Text" Text="Slot 4" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
