<Window x:Class="DropSendTo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropSendTo"
        Icon="img/icon.ico" Height="148" Width="234"
        AllowDrop="True"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Theme.PrimaryTextBrush}"
        WindowStyle="None"
        ResizeMode="NoResize"
        PreviewMouseWheel="OnMouseWheel"
        ShowInTaskbar="False">
    <Window.ContextMenu>
        <ContextMenu Opened="OnContextMenuOpened">
            <MenuItem x:Name="SettingsMenuItem" Header="設定…" Click="OnOpenSettings"/>
            <MenuItem x:Name="PinAppLayerMenuItem" Header="このタブを一時固定" IsCheckable="True" Click="OnPinAppLayer"/>
            <MenuItem x:Name="ShortcutListMenuItem" Header="ショートカット一覧…" Click="OnShowShortcutList"/>
            <MenuItem x:Name="AboutMenuItem" Header="DropSendTo について…" Click="OnShowAbout"/>
            <Separator/>
            <MenuItem x:Name="MinimizeToTrayMenuItem" Header="トレイへ最小化" Click="OnMinimizeToTray"/>
            <MenuItem x:Name="ExitMenuItem" Header="終了" Click="OnExit"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Border CornerRadius="12" Background="{DynamicResource Theme.OverlayScrimBrush}" Padding="6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.RowSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="0"
                    Panel.ZIndex="10"
                    IsHitTestVisible="False">
            <Border x:Name="PrefixIndicator"
                    Padding="8,2"
                    CornerRadius="8"
                    Background="{DynamicResource Theme.BadgeBackgroundBrush}"
                    BorderBrush="{DynamicResource Theme.BadgeBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="PrefixIndicatorText"
                           Text="PREFIX"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
            </Border>
            <Border x:Name="DropIndicator"
                    Margin="0,4,0,0"
                    Padding="8,2"
                    CornerRadius="8"
                    Background="{DynamicResource Theme.BadgeBackgroundBrush}"
                    BorderBrush="{DynamicResource Theme.BadgeBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="DropIndicatorText"
                           Text="Dropped"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
            </Border>
        </StackPanel>
        <Border x:Name="EditModeIndicator"
                Grid.Row="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,4,0,0"
                Padding="8,2"
                CornerRadius="8"
                Background="{DynamicResource Theme.EditBadgeBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.EditBadgeBorderBrush}"
                BorderThickness="1"
                Visibility="Collapsed"
                Panel.ZIndex="11"
                IsHitTestVisible="False">
            <TextBlock x:Name="EditModeIndicatorText"
                       Text="SLOT SETUP MODE"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.EditBadgeTextBrush}"/>
        </Border>
        <!-- Top bar with drag area and buttons (menu + layers equally spaced) -->
        <DockPanel Grid.Row="0" LastChildFill="False" Background="Transparent" MouseLeftButtonDown="OnDragMoveArea">
            <!-- Drag handle area to move window -->
            <Border DockPanel.Dock="Left" Background="Transparent" Height="24" MinWidth="40" MouseLeftButtonDown="OnDragMove">
                <TextBlock x:Name="AppLayerStatusText" FontSize="10" MaxWidth="40" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
            </Border>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="EditModeToggleButton"
                        Content="✎"
                        Width="24"
                        Height="24"
                        Margin="2"
                        ToolTip="Slot Setup Mode"
                        Click="OnEditModeToggleButtonClick"/>
                <Button x:Name="MenuBtn" Content="≡" Width="24" Height="24" Margin="2" Click="OnOpenMenu"/>
                <Button x:Name="LayerBtn1" Content="1" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayerButtonClick" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
                <Button x:Name="LayerBtn2" Content="2" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayerButtonClick" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
                <Button x:Name="LayerBtn3" Content="3" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayerButtonClick" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
                <Button x:Name="LayerBtn4" Content="4" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayerButtonClick" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid x:Name="SlotsPanel"
                     Grid.Row="1"
                     Rows="2"
                     Columns="2"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"/>
    </Grid>
    </Border>
</Window>
