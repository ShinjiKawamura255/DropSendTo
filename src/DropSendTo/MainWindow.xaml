<Window x:Class="DropSendTo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropSendTo"
        Icon="img/icon.ico" Height="148" Width="234"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFFFFFFF"
        WindowStyle="None"
        ResizeMode="NoResize"
        PreviewMouseWheel="OnMouseWheel"
        ShowInTaskbar="False">
    <Window.ContextMenu>
        <ContextMenu Opened="OnContextMenuOpened">
            <MenuItem Header="設定ファイル / ログ">
                <MenuItem Header="Open Config" Click="OnOpenConfig"/>
                <MenuItem Header="Open Logs" Click="OnOpenLogs"/>
                <MenuItem Header="Export Config..." Click="OnExportConfig"/>
                <MenuItem Header="Import Config..." Click="OnImportConfig"/>
            </MenuItem>
            <MenuItem Header="Change Prefix..." Click="OnChangePrefix"/>
            <MenuItem Header="レイアウト / 表示">
                <MenuItem x:Name="LayoutMenuItem"
                          Header="Slot Layout"
                          SubmenuOpened="OnLayoutMenuOpened"/>
                <MenuItem x:Name="SlotSizeMenuItem"
                          Header="Slot Size"
                          SubmenuOpened="OnSlotSizeMenuOpened"/>
            </MenuItem>
            <MenuItem Header="起動時のウィンドウ">
                <MenuItem x:Name="StartupAlwaysShowMenuItem"
                          Header="常にウィンドウを表示"
                          IsCheckable="True"
                          Click="OnStartupAlwaysShow"/>
                <MenuItem x:Name="StartupRestoreMenuItem"
                          Header="前回の状態を復元"
                          IsCheckable="True"
                          Click="OnStartupRestoreState"/>
            </MenuItem>
            <MenuItem Header="Macro 実行モード">
                <MenuItem x:Name="MacroModeExclusiveMenuItem"
                          Header="排他（単一実行のみ）"
                          IsCheckable="True"
                          Click="OnMacroModeExclusive"/>
                <MenuItem x:Name="MacroModeInterruptMenuItem"
                          Header="割り込み実行（実行中マクロを停止）"
                          IsCheckable="True"
                          Click="OnMacroModeInterrupt"/>
                <MenuItem x:Name="MacroModeSuspendMenuItem"
                          Header="一時停止して割り込み（完了後に元マクロ再開）"
                          IsCheckable="True"
                          Click="OnMacroModeSuspend"/>
            </MenuItem>
            <MenuItem x:Name="PrefixLayerShortcutMenuItem"
                      Header="Prefix: Ctrl+N/P でレイヤー切替"
                      IsCheckable="True"
                      Click="OnTogglePrefixLayerShortcuts"/>
            <MenuItem x:Name="RemoteSessionPriorityMenuItem"
                      Header="Prefix: リモートセッション優先 (RDP/Citrix)"
                      IsCheckable="True"
                      Click="OnToggleRemoteSessionPriority"/>
            <Separator/>
            <MenuItem x:Name="AlwaysOnTopMenuItem"
                      Header="常に最前面に表示"
                      IsCheckable="True"
                      Click="OnToggleAlwaysOnTop"/>
            <Separator/>
            <MenuItem x:Name="MinimizeToTrayMenuItem"
                      Header="Minimize to Tray"
                      Click="OnMinimizeToTray"/>
            <MenuItem Header="Exit" Click="OnExit"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Border CornerRadius="12" Background="#CC000000" Padding="6">
    <Grid>
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="#111111"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#202020"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#666666"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#505050"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="PrefixIndicator"
                Grid.RowSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0"
                Padding="8,2"
                CornerRadius="8"
                Background="#33222222"
                BorderBrush="#6600FF99"
                BorderThickness="1"
                Visibility="Collapsed"
                Panel.ZIndex="10"
                IsHitTestVisible="False">
            <TextBlock x:Name="PrefixIndicatorText"
                       Text="PREFIX"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"/>
        </Border>
        <!-- Top bar with drag area and buttons (menu + layers equally spaced) -->
        <DockPanel Grid.Row="0" LastChildFill="False" Background="Transparent" MouseLeftButtonDown="OnDragMoveArea">
            <!-- Drag handle area to move window -->
            <Border DockPanel.Dock="Left" Background="Transparent" Height="24" MinWidth="60" MouseLeftButtonDown="OnDragMove"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="MenuBtn" Content="≡" Width="24" Height="24" Margin="2" Click="OnOpenMenu"/>
                <Button x:Name="LayerBtn1" Content="1" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayer1" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
                <Button x:Name="LayerBtn2" Content="2" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayer2" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
                <Button x:Name="LayerBtn3" Content="3" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayer3" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
                <Button x:Name="LayerBtn4" Content="4" Width="24" Height="24" Margin="2" AllowDrop="True" Click="OnLayer4" DragEnter="OnLayerDragEnter" DragOver="OnLayerDragOver" DragLeave="OnLayerDragLeave"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid x:Name="SlotsPanel"
                     Grid.Row="1"
                     Rows="2"
                     Columns="2"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"/>
    </Grid>
    </Border>
</Window>
