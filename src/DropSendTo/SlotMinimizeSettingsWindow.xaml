<Window x:Class="DropSendTo.SlotMinimizeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minimize Triggers"
        Height="520"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        SizeToContent="Height"
        MinWidth="640"
        Background="#FF111111"
        Foreground="#FFFFFFFF">
    <Border Padding="16" Background="#FF111111" BorderBrush="#FF333333" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Width="96" Margin="4,0" Click="OnCancel"/>
                <Button Content="Save" Width="120" Margin="4,0" IsDefault="True" Click="OnSave"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="デフォルトの最小化トリガー（新規スロットの初期値）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,8">
                    <CheckBox IsChecked="{Binding DefaultOnClick}" Foreground="#FFFFFFFF">
                        <TextBlock Text="Click（スロットクリック実行後）" TextWrapping="Wrap" Foreground="#FFFFFFFF"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding DefaultOnShortcut}" Foreground="#FFFFFFFF">
                        <TextBlock Text="Shortcut（ショートカット起動後）" TextWrapping="Wrap" Foreground="#FFFFFFFF"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding DefaultOnDrop}" Foreground="#FFFFFFFF">
                        <TextBlock Text="Drop（ファイルドロップ起動後）" TextWrapping="Wrap" Foreground="#FFFFFFFF"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding DefaultOnKeyboard}" Foreground="#FFFFFFFF">
                        <TextBlock Text="Keyboard（検索レイヤー等のキーボード起動後）" TextWrapping="Wrap" Foreground="#FFFFFFFF"/>
                    </CheckBox>
                </UniformGrid>
                <TextBlock Text="スロットごとの最小化トリガーを一覧で編集できます。" FontSize="12" Opacity="0.8"/>
            </StackPanel>

            <DataGrid x:Name="SlotsGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      RowHeaderWidth="0"
                      Background="#FF1A1A1A"
                      BorderBrush="#FF333333"
                      Foreground="#FFFFFFFF"
                      HorizontalGridLinesBrush="#333333"
                      VerticalGridLinesBrush="#333333"
                      ColumnHeaderHeight="32"
                      RowHeight="32"
                      SelectionMode="Extended"
                      AlternationCount="2"
                      Margin="0,0,0,4">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF222222"/>
                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        <Setter Property="BorderBrush" Value="#FF333333"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#FF161616"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="BorderBrush" Value="#FF333333"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1F1F1F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF2E4C70"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Layer" Binding="{Binding LayerLabel}" IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn Header="Slot" Binding="{Binding SlotLabel}" IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" IsReadOnly="True" Width="*"/>
                    <DataGridTemplateColumn Header="Click" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding EnableOnClick, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Shortcut" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding EnableOnShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Drop" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding EnableOnDrop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Keyboard" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding EnableOnKeyboard, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</Window>
