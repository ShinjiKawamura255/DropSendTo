<Window x:Class="DropSendTo.SlotMinimizeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Minimize Triggers"
        Height="520"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        SizeToContent="Height"
        MinWidth="640"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.PrimaryTextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Padding="0" Background="{DynamicResource Theme.WindowBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Top" Height="32" Background="{DynamicResource Theme.SurfaceBackgroundBrush}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
                    <Button Content="✕"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="32"
                            Height="24"
                            Margin="0,4,6,4"
                            DockPanel.Dock="Right"
                            Padding="0"
                            Click="OnCloseClicked"/>
                </DockPanel>
            </Border>
            <Border Padding="16" Background="{DynamicResource Theme.WindowBackgroundBrush}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Width="96" Margin="4,0" Click="OnCancel"/>
                        <Button Content="Save" Width="120" Margin="4,0" IsDefault="True" Click="OnSave"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="デフォルトの最小化トリガー（新規スロットの初期値）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <UniformGrid Columns="4" Rows="1" Margin="0,0,0,8">
                            <CheckBox IsChecked="{Binding DefaultOnClick}" Foreground="{DynamicResource Theme.PrimaryTextBrush}">
                                <TextBlock Text="Click（スロットクリック実行後）" TextWrapping="Wrap" Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding DefaultOnShortcut}" Foreground="{DynamicResource Theme.PrimaryTextBrush}">
                                <TextBlock Text="Shortcut（ショートカット起動後）" TextWrapping="Wrap" Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding DefaultOnDrop}" Foreground="{DynamicResource Theme.PrimaryTextBrush}">
                                <TextBlock Text="Drop（ファイルドロップ起動後）" TextWrapping="Wrap" Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding DefaultOnKeyboard}" Foreground="{DynamicResource Theme.PrimaryTextBrush}">
                                <TextBlock Text="Keyboard（検索レイヤー等のキーボード起動後）" TextWrapping="Wrap" Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
                            </CheckBox>
                        </UniformGrid>
                        <TextBlock Text="スロットごとの最小化トリガーを一覧で編集できます。" FontSize="12" Opacity="0.8"/>
                    </StackPanel>

                    <DataGrid x:Name="SlotsGrid"
                              ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              RowHeaderWidth="0"
                              Background="{DynamicResource Theme.SurfaceBackgroundBrush}"
                              BorderBrush="{DynamicResource Theme.BorderBrush}"
                              Foreground="{DynamicResource Theme.PrimaryTextBrush}"
                              HorizontalGridLinesBrush="{DynamicResource Theme.BorderBrush}"
                              VerticalGridLinesBrush="{DynamicResource Theme.BorderBrush}"
                              ColumnHeaderHeight="32"
                              RowHeight="32"
                              SelectionMode="Extended"
                              AlternationCount="2"
                              Margin="0,0,0,4">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource Theme.DataGridHeaderBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{DynamicResource Theme.DataGridRowBackgroundBrush}"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.DataGridRowHoverBackgroundBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.DataGridRowSelectedBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="GridCheckBoxStyle" TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Border x:Name="Bd"
                                                    Width="18"
                                                    Height="18"
                                                    Background="{DynamicResource Theme.SurfaceAltBackgroundBrush}"
                                                    BorderBrush="{DynamicResource Theme.BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <Path x:Name="Mark"
                                                      Data="M 2 8 L 7 13 L 14 3"
                                                      Stroke="{DynamicResource Theme.PrimaryTextBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Visibility="Collapsed"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.ControlHoverBorderBrush}"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ControlHoverBackgroundBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.ControlPressedBorderBrush}"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ControlPressedBackgroundBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ControlHoverBackgroundBrush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.ControlPressedBorderBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                                    <Setter TargetName="Mark" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Layer" Binding="{Binding LayerLabel}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="Slot" Binding="{Binding SlotLabel}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" IsReadOnly="True" Width="*"/>
                            <DataGridTemplateColumn Header="Click" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource GridCheckBoxStyle}" IsChecked="{Binding EnableOnClick, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Shortcut" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource GridCheckBoxStyle}" IsChecked="{Binding EnableOnShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Drop" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource GridCheckBoxStyle}" IsChecked="{Binding EnableOnDrop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Keyboard" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource GridCheckBoxStyle}" IsChecked="{Binding EnableOnKeyboard, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
