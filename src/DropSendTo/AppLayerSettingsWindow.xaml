<Window x:Class="DropSendTo.AppLayerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アプリ別タブ切替" Width="900" Height="660" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.PrimaryTextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <CheckBox x:Name="EnableBox" Margin="0,0,0,10"/>
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,0,0,10"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="FallbackLabel" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="FallbackBox" Width="280" DisplayMemberPath="Name" SelectedValuePath="Index"
                      SelectionChanged="OnPreviewChanged"/>
        </StackPanel>
        <Border Grid.Row="2" Padding="10" Margin="0,0,0,10" CornerRadius="6"
                Background="{DynamicResource Theme.SurfaceBackgroundBrush}">
            <TextBlock x:Name="TargetText" TextWrapping="Wrap"/>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <WrapPanel>
                <Button x:Name="AddLastButton" Click="OnAddLast" Padding="10,5" Margin="0,0,6,6"/>
                <Button x:Name="AddEmptyButton" Click="OnAddEmpty" Padding="10,5" Margin="0,0,6,6"/>
                <Button x:Name="RefreshWindowsButton" Click="OnRefreshWindows" Padding="10,5" Margin="0,0,6,6"/>
            </WrapPanel>
            <DockPanel>
                <Button x:Name="AddWindowButton" DockPanel.Dock="Right" Click="OnAddWindow" Padding="10,5" Margin="6,0,0,0"/>
                <ComboBox x:Name="WindowsBox" MinWidth="200" ToolTip="開いているウィンドウ"/>
            </DockPanel>
        </StackPanel>
        <DataGrid x:Name="RulesGrid" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single"
                  HeadersVisibility="Column" CellEditEnding="OnCellEditEnding" RowHeight="32"
                  Background="{DynamicResource Theme.SurfaceBackgroundBrush}"
                  Foreground="{DynamicResource Theme.PrimaryTextBrush}"
                  BorderBrush="{DynamicResource Theme.BorderBrush}">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource Theme.DataGridHeaderBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
                    <Setter Property="Padding" Value="6,4"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.DataGridRowSelectedBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBackgroundBrush}"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn x:Name="EnabledColumn" Binding="{Binding Enabled, Mode=TwoWay}" Width="50"/>
                <DataGridTextColumn x:Name="ExecutableColumn" Binding="{Binding ExecutableName, Mode=TwoWay}" Width="150"/>
                <DataGridTextColumn x:Name="TitleColumn" Binding="{Binding TitleContains, Mode=TwoWay}" Width="*" MinWidth="120"/>
                <DataGridComboBoxColumn x:Name="LayerColumn" SelectedValueBinding="{Binding LayerIndex, Mode=TwoWay}"
                                        DisplayMemberPath="Name" SelectedValuePath="Index" Width="160">
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>
                <DataGridTextColumn x:Name="PathColumn" Binding="{Binding ExecutablePath, Mode=TwoWay}" Width="*" MinWidth="140"/>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="5" Margin="0,8,0,8">
            <Button x:Name="UpButton" Click="OnMoveUp" Padding="12,5" Margin="0,0,6,0"/>
            <Button x:Name="DownButton" Click="OnMoveDown" Padding="12,5" Margin="0,0,6,0"/>
            <Button x:Name="RemoveButton" Click="OnRemove" Padding="12,5"/>
        </WrapPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="6" Foreground="{DynamicResource Theme.AlertTextBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Click="OnSave" Width="100" Height="32" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Click="OnCancel" Width="100" Height="32"/>
        </StackPanel>
    </Grid>
</Window>
