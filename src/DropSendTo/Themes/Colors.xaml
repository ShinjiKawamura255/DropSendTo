<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base surfaces -->
    <SolidColorBrush x:Key="Theme.WindowBackgroundBrush" Color="#FF111111"/>
    <SolidColorBrush x:Key="Theme.SurfaceBackgroundBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="Theme.SurfaceAltBackgroundBrush" Color="#FF161616"/>
    <SolidColorBrush x:Key="Theme.CardBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Theme.OverlayScrimBrush" Color="#CC000000"/>
    <SolidColorBrush x:Key="Theme.OverlayBackgroundBrush" Color="#CC111111"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="Theme.BorderBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="Theme.SubtleBorderBrush" Color="#555555"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Theme.PrimaryTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Theme.SecondaryTextBrush" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="Theme.MutedTextBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="Theme.SubtleTextBrush" Color="#999999"/>
    <SolidColorBrush x:Key="Theme.PlaceholderTextBrush" Color="#888888"/>
    <SolidColorBrush x:Key="Theme.CodeTextBrush" Color="#F0F0F0"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="Theme.ControlBackgroundBrush" Color="#111111"/>
    <SolidColorBrush x:Key="Theme.ControlHoverBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="Theme.ControlPressedBackgroundBrush" Color="#505050"/>
    <SolidColorBrush x:Key="Theme.ControlBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="Theme.ControlHoverBorderBrush" Color="#666666"/>
    <SolidColorBrush x:Key="Theme.ControlPressedBorderBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.InputBackgroundBrush" Color="#222222"/>
    <SolidColorBrush x:Key="Theme.InputBorderBrush" Color="#555555"/>

    <!-- Accents / badges -->
    <SolidColorBrush x:Key="Theme.BadgeBackgroundBrush" Color="#33222222"/>
    <SolidColorBrush x:Key="Theme.BadgeBorderBrush" Color="#6600FF99"/>
    <SolidColorBrush x:Key="Theme.EditBadgeBackgroundBrush" Color="#33252200"/>
    <SolidColorBrush x:Key="Theme.EditBadgeBorderBrush" Color="#66FFCC66"/>
    <SolidColorBrush x:Key="Theme.EditBadgeTextBrush" Color="#FFE4FFCC"/>

    <!-- Status -->
    <SolidColorBrush x:Key="Theme.WarningTextBrush" Color="#E69500"/>
    <SolidColorBrush x:Key="Theme.AlertTextBrush" Color="#FF6666"/>
    <SolidColorBrush x:Key="Theme.ValidationTextBrush" Color="#FFCC3333"/>
    <SolidColorBrush x:Key="Theme.AlertBackgroundBrush" Color="#33FF3333"/>
    <SolidColorBrush x:Key="Theme.AlertBorderBrush" Color="#FFFF6666"/>

    <!-- Tables -->
    <SolidColorBrush x:Key="Theme.DataGridHeaderBackgroundBrush" Color="#FF222222"/>
    <SolidColorBrush x:Key="Theme.DataGridRowBackgroundBrush" Color="#FF161616"/>
    <SolidColorBrush x:Key="Theme.DataGridRowHoverBackgroundBrush" Color="#FF1F1F1F"/>
    <SolidColorBrush x:Key="Theme.DataGridRowSelectedBrush" Color="#FF2E4C70"/>
    <SolidColorBrush x:Key="Theme.RowErrorBrush" Color="#33FF5555"/>
    <SolidColorBrush x:Key="Theme.RowWarningBrush" Color="#33FFA500"/>
    <SolidColorBrush x:Key="Theme.RowShadowedBrush" Color="#333366FF"/>
</ResourceDictionary>
