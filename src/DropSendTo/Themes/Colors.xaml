<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Base surfaces -->
    <SolidColorBrush x:Key="Theme.WindowBackgroundBrush" Color="#FF111111"/>
    <SolidColorBrush x:Key="Theme.SurfaceBackgroundBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="Theme.SurfaceAltBackgroundBrush" Color="#FF161616"/>
    <SolidColorBrush x:Key="Theme.CardBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Theme.OverlayScrimBrush" Color="#CC000000"/>
    <SolidColorBrush x:Key="Theme.OverlayBackgroundBrush" Color="#CC111111"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="Theme.BorderBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="Theme.SubtleBorderBrush" Color="#555555"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Theme.PrimaryTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Theme.SecondaryTextBrush" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="Theme.MutedTextBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="Theme.SubtleTextBrush" Color="#999999"/>
    <SolidColorBrush x:Key="Theme.PlaceholderTextBrush" Color="#888888"/>
    <SolidColorBrush x:Key="Theme.CodeTextBrush" Color="#F0F0F0"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="Theme.ControlBackgroundBrush" Color="#111111"/>
    <SolidColorBrush x:Key="Theme.ControlHoverBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="Theme.ControlPressedBackgroundBrush" Color="#505050"/>
    <SolidColorBrush x:Key="Theme.ControlBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="Theme.ControlHoverBorderBrush" Color="#666666"/>
    <SolidColorBrush x:Key="Theme.ControlPressedBorderBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.InputBackgroundBrush" Color="#222222"/>
    <SolidColorBrush x:Key="Theme.InputBorderBrush" Color="#555555"/>

    <!-- Accents / badges -->
    <SolidColorBrush x:Key="Theme.BadgeBackgroundBrush" Color="#33222222"/>
    <SolidColorBrush x:Key="Theme.BadgeBorderBrush" Color="#6600FF99"/>
    <SolidColorBrush x:Key="Theme.EditBadgeBackgroundBrush" Color="#33252200"/>
    <SolidColorBrush x:Key="Theme.EditBadgeBorderBrush" Color="#66FFCC66"/>
    <SolidColorBrush x:Key="Theme.EditBadgeTextBrush" Color="#FFE4FFCC"/>

    <!-- Status -->
    <SolidColorBrush x:Key="Theme.WarningTextBrush" Color="#E69500"/>
    <SolidColorBrush x:Key="Theme.AlertTextBrush" Color="#FF6666"/>
    <SolidColorBrush x:Key="Theme.ValidationTextBrush" Color="#FFCC3333"/>
    <SolidColorBrush x:Key="Theme.AlertBackgroundBrush" Color="#33FF3333"/>
    <SolidColorBrush x:Key="Theme.AlertBorderBrush" Color="#FFFF6666"/>

    <!-- Tables -->
    <SolidColorBrush x:Key="Theme.DataGridHeaderBackgroundBrush" Color="#FF222222"/>
    <SolidColorBrush x:Key="Theme.DataGridRowBackgroundBrush" Color="#FF161616"/>
    <SolidColorBrush x:Key="Theme.DataGridRowHoverBackgroundBrush" Color="#FF1F1F1F"/>
    <SolidColorBrush x:Key="Theme.DataGridRowSelectedBrush" Color="#FF2E4C70"/>
    <SolidColorBrush x:Key="Theme.RowErrorBrush" Color="#33FF5555"/>
    <SolidColorBrush x:Key="Theme.RowWarningBrush" Color="#33FFA500"/>
    <SolidColorBrush x:Key="Theme.RowShadowedBrush" Color="#333366FF"/>

    <!-- Slot visuals -->
    <SolidColorBrush x:Key="Theme.SlotBackgroundBrush" Color="#FF111111"/>
    <SolidColorBrush x:Key="Theme.SlotBorderBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="Theme.SlotHoverBackgroundBrush" Color="#FF202020"/>
    <SolidColorBrush x:Key="Theme.SlotHoverBorderBrush" Color="#FF808080"/>
    <SolidColorBrush x:Key="Theme.SlotPressedBackgroundBrush" Color="#FF303030"/>
    <SolidColorBrush x:Key="Theme.SlotPressedBorderBrush" Color="#FFC8C8C8"/>
    <SolidColorBrush x:Key="Theme.SlotDragBackgroundBrush" Color="#FF283038"/>
    <SolidColorBrush x:Key="Theme.SlotDragBorderBrush" Color="#FF7CFFB0"/>
    <SolidColorBrush x:Key="Theme.SlotDragSourceBackgroundBrush" Color="#FF1A351A"/>
    <SolidColorBrush x:Key="Theme.SlotDragSourceBorderBrush" Color="#FF7CFFB0"/>
    <SolidColorBrush x:Key="Theme.SlotPreviewBackgroundBrush" Color="#BB102410"/>
    <SolidColorBrush x:Key="Theme.SlotPreviewBorderBrush" Color="#FF66FFCC"/>
    <SolidColorBrush x:Key="Theme.SlotPreviewTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Theme.SlotStatusTextBrush" Color="#FF7CFFB0"/>
    <SolidColorBrush x:Key="Theme.SlotRunningBackgroundBrush" Color="#FF1A2E1A"/>
    <SolidColorBrush x:Key="Theme.SlotRunningBorderBrush" Color="#FF5AD66B"/>
    <SolidColorBrush x:Key="Theme.SlotRunningTextBrush" Color="#FF7CFFB0"/>
    <SolidColorBrush x:Key="Theme.SlotCancellingBackgroundBrush" Color="#FF2E281A"/>
    <SolidColorBrush x:Key="Theme.SlotCancellingBorderBrush" Color="#FFFFC64D"/>
    <SolidColorBrush x:Key="Theme.SlotCancellingTextBrush" Color="#FFFFD766"/>
    <SolidColorBrush x:Key="Theme.SlotPausedBackgroundBrush" Color="#FF1E1A2E"/>
    <SolidColorBrush x:Key="Theme.SlotPausedBorderBrush" Color="#FF987CFF"/>
    <SolidColorBrush x:Key="Theme.SlotPausedTextBrush" Color="#FFC9B6FF"/>

    <!-- Layer buttons -->
    <SolidColorBrush x:Key="Theme.LayerButtonActiveBackgroundBrush" Color="#FF222222"/>
    <SolidColorBrush x:Key="Theme.LayerButtonActiveBorderBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Theme.LayerButtonActiveTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Theme.LayerButtonInactiveBackgroundBrush" Color="#FF111111"/>
    <SolidColorBrush x:Key="Theme.LayerButtonInactiveBorderBrush" Color="#FF444444"/>
    <SolidColorBrush x:Key="Theme.LayerButtonInactiveTextBrush" Color="#FFFFFFFF"/>

    <!-- Prefix indicator -->
    <SolidColorBrush x:Key="Theme.PrefixArmedBackgroundBrush" Color="#FF1E824C"/>
    <SolidColorBrush x:Key="Theme.PrefixArmedBorderBrush" Color="#FF7CFFB0"/>
    <SolidColorBrush x:Key="Theme.PrefixArmedTextBrush" Color="#FFFFFFFF"/>

    <!-- System color overrides (dark theme) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF202020"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF111111"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF111111"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFFFF"/>

    <sys:Boolean x:Key="Theme.UseDarkTitleBar">True</sys:Boolean>
</ResourceDictionary>
