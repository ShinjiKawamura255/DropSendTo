<Window x:Class="DropSendTo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="860" Height="700" MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.PrimaryTextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="HeadingText" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="HelpText" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Categories" SelectionChanged="OnCategoryChanged"
                     Background="{DynamicResource Theme.SurfaceBackgroundBrush}"
                     Foreground="{DynamicResource Theme.PrimaryTextBrush}"
                     BorderBrush="{DynamicResource Theme.BorderBrush}"
                     HorizontalContentAlignment="Stretch" Margin="0,0,18,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,14"/>
                        <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.ControlHoverBackgroundBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Pages" Margin="0,0,12,0"/>
            </ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="100" Height="34"
                    Click="OnClose" IsCancel="True"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource Theme.AlertTextBrush}"/>
        </DockPanel>
    </Grid>
</Window>
