<Window x:Class="DropSendTo.PrefixDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Change Prefix" Height="220" Width="360" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        Background="{StaticResource Theme.WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Height="32" Background="{StaticResource Theme.SurfaceBackgroundBrush}" MouseLeftButtonDown="OnTitleBarDrag">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Theme.PrimaryTextBrush}"/>
                <Button Content="✕"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="32"
                        Height="24"
                        Margin="0,4,6,4"
                        DockPanel.Dock="Right"
                        Padding="0"
                        Click="OnCloseClicked"/>
            </DockPanel>
        </Border>
        <Grid Margin="14" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Prefix" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="PrefixBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

        <CheckBox x:Name="DisableCheckBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="プレフィックスを無効化する" Checked="OnDisableChanged" Unchecked="OnDisableChanged" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                   Text="例: Ctrl+Q / Ctrl+Shift+S / Alt+F4 / Win+1"
                   Foreground="{StaticResource Theme.MutedTextBrush}" FontSize="12"/>

        <TextBlock x:Name="WarningBlock" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="{StaticResource Theme.WarningTextBrush}" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"
                   Text="プレフィックスを無効化すると、登録したショートカットは使用できなくなります。"/>

        <TextBlock x:Name="ErrorBlock" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="{StaticResource Theme.AlertTextBrush}" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    HorizontalAlignment="Right">
            <Button Content="OK" Width="90" Height="32" Margin="4" IsDefault="True" Click="OnOk"/>
            <Button Content="Cancel" Width="90" Height="32" Margin="4" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
