<Window x:Class="DropSendTo.MacroSnippetSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="マクロ挿入を検索"
        Height="420"
        Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{DynamicResource Theme.WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Height="32" Background="{DynamicResource Theme.SurfaceBackgroundBrush}" MouseLeftButtonDown="OnTitleBarDrag">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
                <Button Content="✕"
                        Width="32"
                        Height="24"
                        Margin="0,4,6,4"
                        DockPanel.Dock="Right"
                        Padding="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClicked"/>
            </DockPanel>
        </Border>

        <Grid Margin="12" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="検索" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" MinWidth="240" TextChanged="OnSearchTextChanged" />
            </DockPanel>

            <ListView x:Name="SnippetList"
                      Grid.Row="1"
                      MouseDoubleClick="OnSnippetDoubleClick"
                      SelectionMode="Single"
                      Background="{DynamicResource Theme.SurfaceBackgroundBrush}"
                      Foreground="{DynamicResource Theme.PrimaryTextBrush}"
                      BorderBrush="{DynamicResource Theme.BorderBrush}">
                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource Theme.DataGridHeaderBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="{DynamicResource Theme.DataGridRowBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            SnapsToDevicePixels="True">
                                        <GridViewRowPresenter Margin="{TemplateBinding Padding}"
                                                              Content="{TemplateBinding Content}"
                                                              Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ControlHoverBackgroundBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DataGridRowSelectedBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="カテゴリ" Width="160" DisplayMemberBinding="{Binding Group}"/>
                        <GridViewColumn Header="コマンド" Width="180" DisplayMemberBinding="{Binding Header}"/>
                        <GridViewColumn Header="内容" Width="260" DisplayMemberBinding="{Binding Content}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="挿入" Width="90" Height="30" Margin="4" IsDefault="True" Click="OnInsertClicked"/>
            <Button Content="閉じる" Width="90" Height="30" Margin="4" IsCancel="True" Click="OnCloseClicked"/>
        </StackPanel>
    </Grid>
</Window>
