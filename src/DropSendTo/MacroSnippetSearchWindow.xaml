<Window x:Class="DropSendTo.MacroSnippetSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="マクロ挿入を検索"
        Height="420"
        Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="ToolWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="検索" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" MinWidth="240" TextChanged="OnSearchTextChanged" />
        </DockPanel>

        <ListView x:Name="SnippetList"
                  Grid.Row="1"
                  MouseDoubleClick="OnSnippetDoubleClick"
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="カテゴリ" Width="160" DisplayMemberBinding="{Binding Group}"/>
                    <GridViewColumn Header="コマンド" Width="180" DisplayMemberBinding="{Binding Header}"/>
                    <GridViewColumn Header="内容" Width="260" DisplayMemberBinding="{Binding Content}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="挿入" Width="90" Height="30" Margin="4" IsDefault="True" Click="OnInsertClicked"/>
            <Button Content="閉じる" Width="90" Height="30" Margin="4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
