<Window x:Class="DropSendTo.SlotSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="空きスロットを選択"
        Height="360"
        Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="移動/コピー先の空きスロットを選択してください。"
                   Margin="0 0 0 8"
                   TextWrapping="Wrap" />

        <ListBox x:Name="SlotList"
                 Grid.Row="1"
                 BorderThickness="1"
                 DisplayMemberPath="DisplayName"
                 SelectionMode="Single"
                 MouseDoubleClick="OnSlotDoubleClick"
                 SelectionChanged="OnSelectionChanged"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 10 0 0">
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="80"
                    Margin="0 0 8 0"
                    IsDefault="True"
                    Click="OnOk"/>
            <Button Content="キャンセル"
                    Width="80"
                    IsCancel="True"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
