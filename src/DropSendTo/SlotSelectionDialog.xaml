<Window x:Class="DropSendTo.SlotSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:ClassModifier="internal"
        Title="空きスロットを選択"
        Height="360"
        Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Height="32" Background="{DynamicResource Theme.SurfaceBackgroundBrush}" MouseLeftButtonDown="OnTitleBarDrag">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.PrimaryTextBrush}"/>
                <Button Content="✕"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="32"
                        Height="24"
                        Margin="0,4,6,4"
                        DockPanel.Dock="Right"
                        Padding="0"
                        Click="OnCloseClicked"/>
            </DockPanel>
        </Border>

        <Grid Margin="12" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="移動/コピー先の空きスロットを選択してください。"
                       Margin="0 0 0 8"
                       TextWrapping="Wrap" />

            <ListBox x:Name="SlotList"
                     Grid.Row="1"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource Theme.BorderBrush}"
                     Background="{DynamicResource Theme.SurfaceBackgroundBrush}"
                     Foreground="{DynamicResource Theme.PrimaryTextBrush}"
                     DisplayMemberPath="DisplayName"
                     SelectionMode="Single"
                     MouseDoubleClick="OnSlotDoubleClick"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ControlHoverBackgroundBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.ControlHoverBorderBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DataGridRowSelectedBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.ControlPressedBorderBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0 10 0 0">
                <Button x:Name="OkButton"
                        Content="OK"
                        Width="80"
                        Margin="0 0 8 0"
                        IsDefault="True"
                        Click="OnOk"/>
                <Button Content="キャンセル"
                        Width="80"
                        IsCancel="True"
                        Click="OnCancel"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
